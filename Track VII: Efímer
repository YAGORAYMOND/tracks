samples({
  rain:'noise/rain_crackle.wav',
  res:'vocals/res_es_per_sempre/res.wav',
  es_per_sempre:'vocals/res_es_per_sempre/es_per_sempre.wav',
  que_val_la_pena:'vocals/res_es_per_sempre/que_val_la_pena.wav',
}, 'https://raw.githubusercontent.com/YAGORAYMOND/samples/refs/heads/main/');

setcpm(30)

base: n("3!4").chord("<A Em B E>").voicing()
.clip("2")
.transpose("<-12 0>".slow(8))
.attack(0.1)
.delay(0.3).room(1.3)
.s("gm_acoustic_guitar_steel")
.postgain(0.6)
.lpf(slider(2000,300,2000)) 


chord: chord("<A Em B E>").n("4 1 [3 4] 2 7").voicing().dec(.2)
  .struct("x - - x x - x").degradeBy(0.5)
  .s("gm_acoustic_guitar_steel")
  .transpose(choose("-12","-5","0"))
  .sustain(1).release(1).room(0.4)
  .sometimesBy(0.1,off(1/32, x=>x))


//rain crackle layer
rain: s("rain").slow(5).clip(1).gain(0.5)

//vocals
_res: s("res").slow(2).gain(.5).room(1)
.off(1/16,x=>x.speed("-1|-2").gain("<0 0.3>".slow(2)))
  
_res: s("<res es_per_sempre>").slow(4).gain(0.6)

que_val_la_pena: s("que_val_la_pena").slow(4).note("A0").bpf(1000).pan(0.4)
